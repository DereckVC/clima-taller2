# Optional: without a provider key Aura runs in deterministic weather demo mode.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MODELS=qwen3.5:4b,qwen2.5:3b,llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Open-Meteo (clima en tiempo real) ───────────────────────────────────────
# API 100% gratuita, sin registro ni API key requerida.
# Documentación: https://open-meteo.com/en/docs
# Los datos se cachean 5 minutos en el servidor Next.js (revalidate=300).
# No se necesita configurar nada; funciona de forma automática.
